# Copy to .env and fill in.
# These are read at build time via app.config.ts → expo Constants.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — used by supabase/demo-users.ts and migration scripts.
# Never expose in app code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Direct Postgres connection (for psql / migration scripts only).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# Currency conversion (free, no key required)
EXPO_PUBLIC_FX_API_URL=https://open.er-api.com/v6/latest

# Optional: app-wide defaults
EXPO_PUBLIC_DEFAULT_CURRENCY=USD
EXPO_PUBLIC_DEFAULT_LANGUAGE=en
